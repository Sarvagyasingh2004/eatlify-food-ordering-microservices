# Eatlify reverse proxy. ${DOMAIN} is substituted at container start by the
# nginx image's envsubst step; NGINX_ENVSUBST_FILTER=DOMAIN keeps nginx's own
# runtime variables ($host, $remote_addr, ...) intact.

upstream auth_svc       { server auth:5001; }
upstream restaurant_svc { server restaurant:5002; }
upstream utils_svc      { server utils:5003; }
upstream realtime_svc   { server realtime:5004; }
upstream rider_svc      { server rider:5005; }
upstream admin_svc      { server admin:5006; }

# ---------- port 80: ACME challenge, then redirect ----------
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Must stay on HTTP and must not redirect, or renewal fails
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- port 443: the application ----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Restaurant and rider profile images arrive as multipart, and utils accepts
    # 50mb JSON bodies. nginx defaults to 1m, which silently breaks every upload.
    client_max_body_size 50m;

    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Inherited by every location below that does not set its own
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # --- never expose these ---
    # /api/v1/internal/ emits to any socket room, guarded only by a shared key.
    # /api/upload is unauthenticated and writes to a billable Cloudinary
    # account. Both are service-to-service only and reach each other over the
    # private docker network, so neither needs a public route.
    location /api/v1/internal/ { deny all; }
    location = /api/upload     { deny all; }

    # --- websocket ---
    # SocketContext requests the websocket transport with no polling fallback,
    # so without these upgrade headers realtime fails silently rather than
    # degrading. Setting proxy_set_header here discards the inherited set, so
    # the common headers are repeated.
    location /socket.io/ {
        proxy_pass http://realtime_svc;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 7d;
        proxy_send_timeout 7d;
    }

    # --- auth ---
    location /api/auth/   { proxy_pass http://auth_svc; }
    location /api/health  { proxy_pass http://auth_svc; }

    # --- restaurant (owns orders too) ---
    location /api/restaurant/ { proxy_pass http://restaurant_svc; }
    location /api/item/       { proxy_pass http://restaurant_svc; }
    location /api/cart/       { proxy_pass http://restaurant_svc; }
    location /api/address/    { proxy_pass http://restaurant_svc; }
    location /api/order/      { proxy_pass http://restaurant_svc; }

    # --- payments ---
    location /api/payment/ { proxy_pass http://utils_svc; }

    # --- rider ---
    location /api/rider/ { proxy_pass http://rider_svc; }

    # --- admin ---
    location /api/v1/admin/ { proxy_pass http://admin_svc; }

    # The frontend lives on Vercel; nothing else is served here
    location / { return 404; }
}
