# Eatlify reverse proxy. ${DOMAIN} is substituted at container start by the
# nginx image's envsubst step; NGINX_ENVSUBST_FILTER=DOMAIN keeps nginx's own
# runtime variables ($host, $remote_addr, ...) intact.

# Deliberately no upstream{} blocks. nginx resolves those once at config load,
# so a container that restarts - a deploy, a crash, an OOM kill - comes back on
# a new IP and nginx keeps proxying to the dead one until it is reloaded, which
# looks like a permanent 502 from a service that is actually healthy.
#
# Docker's embedded DNS plus a variable in proxy_pass forces re-resolution per
# request instead, so a restart heals itself within `valid`.

# ---------- port 80: ACME challenge, then redirect ----------
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Must stay on HTTP and must not redirect, or renewal fails
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- port 443: the application ----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    # Docker's embedded DNS. ipv6=off because the containers are v4-only and
    # nginx would otherwise wait on AAAA lookups that never resolve.
    resolver 127.0.0.11 valid=10s ipv6=off;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Restaurant and rider profile images arrive as multipart, and utils accepts
    # 50mb JSON bodies. nginx defaults to 1m, which silently breaks every upload.
    client_max_body_size 50m;

    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Inherited by every location below that does not set its own
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # --- never expose these ---
    # /api/v1/internal/ emits to any socket room, guarded only by a shared key.
    # /api/upload is unauthenticated and writes to a billable Cloudinary
    # account. Both are service-to-service only and reach each other over the
    # private docker network, so neither needs a public route.
    location /api/v1/internal/ { deny all; }
    location = /api/upload     { deny all; }

    # --- websocket ---
    # SocketContext requests the websocket transport with no polling fallback,
    # so without these upgrade headers realtime fails silently rather than
    # degrading. Setting proxy_set_header here discards the inherited set, so
    # the common headers are repeated.
    location /socket.io/ {
        set $realtime_upstream http://realtime:5004;
        proxy_pass $realtime_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 7d;
        proxy_send_timeout 7d;
    }

    # --- auth ---
    location /api/auth/   { set $auth_upstream http://auth:5001; proxy_pass $auth_upstream; }
    location /api/health  { set $health_upstream http://auth:5001; proxy_pass $health_upstream; }

    # --- restaurant (owns orders too) ---
    location /api/restaurant/ { set $r1 http://restaurant:5002; proxy_pass $r1; }
    location /api/item/       { set $r2 http://restaurant:5002; proxy_pass $r2; }
    location /api/cart/       { set $r3 http://restaurant:5002; proxy_pass $r3; }
    location /api/address/    { set $r4 http://restaurant:5002; proxy_pass $r4; }
    location /api/order/      { set $r5 http://restaurant:5002; proxy_pass $r5; }

    # --- payments ---
    location /api/payment/ { set $utils_upstream http://utils:5003; proxy_pass $utils_upstream; }

    # --- rider ---
    location /api/rider/ { set $rider_upstream http://rider:5005; proxy_pass $rider_upstream; }

    # --- admin ---
    location /api/v1/admin/ { set $admin_upstream http://admin:5006; proxy_pass $admin_upstream; }

    # The frontend lives on Vercel; nothing else is served here
    location / { return 404; }
}
