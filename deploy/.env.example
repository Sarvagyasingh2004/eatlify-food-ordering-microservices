# One shared file for all six services. Compose sets each service's PORT itself,
# so it is deliberately absent here.
#
#   cp .env.example .env    then fill it in. .env is gitignored.

# ---------- deployment ----------
# Your DuckDNS subdomain, without a scheme. Must already resolve to this box
# before you run ./init-tls.sh, or Let's Encrypt cannot validate it.
DOMAIN=your-subdomain.duckdns.org

# Where Let's Encrypt sends expiry warnings
LETSENCRYPT_EMAIL=you@example.com

# ---------- database ----------
# The mongoose services hardcode dbName, so the database in this URI is ignored
# by them. DB_NAME below is what the admin service uses and must match.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
DB_NAME=Food_Ordering_db

# ---------- shared secrets ----------
# Every service verifies the same token, so this must be byte-identical to what
# issued your existing tokens - changing it logs everyone out.
JWT_SECRET=

# Guards service-to-service routes. Never give this a VITE_ prefix and never
# let it reach the browser.
INTERNAL_SERVICE_KEY=

# ---------- internal service URLs ----------
# Container names on the compose network, not localhost.
UTILS_SERVICE=http://utils:5003
REALTIME_SERVICE=http://realtime:5004
RESTAURANT_SERVICE=http://restaurant:5002

# ---------- broker ----------
# RABBITMQ_URL must use the same credentials as the two variables below,
# and the host must be the container name.
RABBITMQ_USER=eatlify
RABBITMQ_PASS=
RABBITMQ_URL=amqp://eatlify:<same password>@rabbitmq:5672
PAYMENT_QUEUE=payment_queue
RIDER_QUEUE=rider_queue
ORDER_READY_QUEUE=order_ready_queue

# ---------- CORS ----------
# Comma-separated. Must include your Vercel origin, or every browser request is
# rejected. Add http://localhost:5173 too if you point a local frontend here.
CORS_ORIGIN=https://your-app.vercel.app

# ---------- google oauth ----------
# Also add the Vercel origin to Authorized JavaScript origins in Google Cloud
# Console, or login fails with no useful error.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- cloudinary ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- payments ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# Where Stripe Checkout returns the customer - your Vercel URL
FRONTEND_URL=https://your-app.vercel.app
