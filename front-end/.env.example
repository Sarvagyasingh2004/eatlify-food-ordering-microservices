# Single backend origin. Leave unset for local development - main.tsx then falls
# back to the per-service localhost ports (5001-5006).
# In production nginx path-routes /api/* to each service behind one hostname:
#   VITE_API_BASE_URL=https://your-subdomain.duckdns.org
VITE_API_BASE_URL=

# Browser-side OAuth client id. Public by design, not a secret.
VITE_GOOGLE_CLIENT_ID=

# Stripe publishable key. Public by design.
VITE_STRIPE_PUBLISHABLE_KEY=
