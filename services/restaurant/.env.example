PORT=5002

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
JWT_SECRET=

# Internal service URLs. In Docker these are container names, e.g. http://utils:5003
UTILS_SERVICE=http://localhost:5003
REALTIME_SERVICE=http://localhost:5004

# Shared secret for service-to-service calls. Never expose this to the browser.
INTERNAL_SERVICE_KEY=

RABBITMQ_URL=amqp://<user>:<password>@localhost:5672
PAYMENT_QUEUE=payment_queue
RIDER_QUEUE=rider_queue
ORDER_READY_QUEUE=order_ready_queue

CORS_ORIGIN=http://localhost:5173
