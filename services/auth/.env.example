PORT=5001

# Database name is hardcoded to Food_Ordering_db in src/config/db.ts
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# Must be byte-identical across every service - they all verify the same token
JWT_SECRET=

# From Google Cloud Console. The redirect URI is "postmessage" (hardcoded in
# src/config/googleConfig.ts) because the frontend uses the auth-code popup
# flow - there is no redirect URI to configure here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
