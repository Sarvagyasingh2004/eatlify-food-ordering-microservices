PORT=5006

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# This service uses the raw MongoDB driver, so the database name is explicit.
# It must match the value the mongoose services hardcode, or the admin panel
# reads an empty database and reports no pending approvals.
DB_NAME=Food_Ordering_db

JWT_SECRET=

CORS_ORIGIN=http://localhost:5173
